# Files that belong in the repository but not in a release zip.
#
# `git archive` honours export-ignore, so ./deploy.sh --zip gets its exclusion
# list from here rather than from a list of rm commands someone has to remember.
# Anything untracked (vendor/, .git/) is absent from a git archive already.
#
# tests/ is deliberately NOT listed. The Moodle Marketplace package should carry
# it: the prechecker does not run PHPUnit, but reviewers and site admins expect
# a plugin's tests to ship with it, and it costs 184K compressed. ./deploy.sh
# --zip --slim strips it when a leaner production package is wanted.
#
# Verify with: git check-attr export-ignore -- <path>
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/.eslintrc          export-ignore
/deploy.sh          export-ignore
/composer.json      export-ignore
/.claude            export-ignore
/.DS_Store          export-ignore
/.moodle-plugin-ci.yml export-ignore
/.phpcsignore       export-ignore
/.stylelintrc.json  export-ignore
/CLAUDE.md          export-ignore
/docs               export-ignore
/phpcs.xml          export-ignore
